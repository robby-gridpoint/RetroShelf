<Window x:Class="RetroShelf.Views.PostLaunchSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session complete"
        Width="390" Height="270"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F4F4"
        FontFamily="Segoe UI"
        FontSize="12">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Session complete" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="GameNameText" Grid.Row="1" Margin="0,3,0,0" Foreground="#666666" />

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Session time" Margin="0,0,0,8" Foreground="#666666" />
            <TextBlock x:Name="SessionTimeText" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="Total play time" Margin="0,0,0,8" Foreground="#666666" />
            <TextBlock x:Name="TotalPlayTimeText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Text="Total launches" Foreground="#666666" />
            <TextBlock x:Name="LaunchCountText" Grid.Row="2" Grid.Column="1" />
        </Grid>

        <CheckBox x:Name="ShowFutureSummariesCheckBox" Grid.Row="3"
                  Content="Show a summary after future game sessions"
                  IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,16" />

        <Button Grid.Row="4" Content="OK" Width="80" Height="26" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="OkButton_Click" />
    </Grid>
</Window>
