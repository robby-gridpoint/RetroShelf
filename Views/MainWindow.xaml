    <Window x:Class="RetroShelf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RetroShelf" Height="700" Width="1100" MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4"
        FontFamily="Segoe UI" FontSize="12"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#F4F4F4" />
        <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToolbarBackground" Color="#FAFAFA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D2D2D2" />
        <SolidColorBrush x:Key="TextPrimary" Color="#202020" />
        <SolidColorBrush x:Key="TextSecondary" Color="#666666" />
        <SolidColorBrush x:Key="Accent" Color="#2878C8" />

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EAF2FB" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7AA7D5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D8E8F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1F68B0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="#B8B8B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#ECECEC" />
            <Setter Property="Foreground" Value="#303030" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CenteredColumnText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="VerticallyCenteredText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CDE7FF" />
                    <Setter Property="Foreground" Value="#101010" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="BorderBrush" Value="#ECECEC" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="CompatibilityBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Background" Value="#ECEFF1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasCompatibility}" Value="True">
                    <Setter Property="Background" Value="#DCEEFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompatibilityBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6368" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasCompatibility}" Value="True">
                    <Setter Property="Foreground" Value="#145A92" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InstallProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Background" Value="#E4E4E4" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F6F6F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="_Install Game Package..." Click="InstallButton_Click" />
                <MenuItem Header="Open Games Directory" Click="OpenGamesDirectory_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="CloseButton_Click" />
            </MenuItem>
            <MenuItem Header="_Game">
                <MenuItem Header="_Play" Click="PlayButton_Click" />
                <MenuItem Header="Open Install _Folder" Click="RevealButton_Click" />
                <Separator />
                <MenuItem Header="_Uninstall" Click="UninstallButton_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Refresh _Compatibility" Click="RefreshCompatibility_Click" />
                <MenuItem x:Name="ShowPostLaunchSummariesMenuItem"
                          Header="Show After-Launch _Summaries"
                          IsCheckable="True"
                          Click="ShowPostLaunchSummaries_Click" />
                <Separator />
                <MenuItem Header="_About RetroShelf" Click="AboutButton_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{StaticResource ToolbarBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <Button Click="InstallButton_Click" Content="Install ZIP..." Margin="0,0,6,0" />
                <Button Grid.Column="1" Click="PlayButton_Click" Content="Play Selected"
                        Style="{StaticResource PrimaryButton}" />
                <TextBlock Grid.Column="3" Text="Search:" VerticalAlignment="Center" Margin="0,0,7,0" />
                <TextBox x:Name="SearchBox" Grid.Column="4" TextChanged="SearchBox_TextChanged" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="GameList" Grid.Column="0" ItemsSource="{Binding}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8E8E8"
                      VerticalGridLinesBrush="#ECECEC" HeadersVisibility="Column"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      Background="White" BorderThickness="0"
                      SelectionChanged="GameList_SelectionChanged"
                      MouseDoubleClick="GameList_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Game" Binding="{Binding Name}" Width="*" MinWidth="180"
                                        ElementStyle="{StaticResource VerticallyCenteredText}" />
                    <DataGridTemplateColumn Header="Compatibility" Width="110"
                                            HeaderStyle="{StaticResource CenteredColumnHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CompatibilityBadge}">
                                    <TextBlock Text="{Binding CompatibilityBadge}"
                                               Style="{StaticResource CompatibilityBadgeText}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Last Played" Binding="{Binding LastPlayedDisplay}" Width="150"
                                        HeaderStyle="{StaticResource CenteredColumnHeader}"
                                        ElementStyle="{StaticResource CenteredColumnText}" />
                    <DataGridTextColumn Header="Play Time" Binding="{Binding PlayTimeDisplay}" Width="100"
                                        HeaderStyle="{StaticResource CenteredColumnHeader}"
                                        ElementStyle="{StaticResource CenteredColumnText}" />
                    <DataGridTextColumn Header="Launches" Binding="{Binding PlayCount}" Width="85"
                                        HeaderStyle="{StaticResource CenteredColumnHeader}"
                                        ElementStyle="{StaticResource CenteredColumnText}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Background="#F8F8F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid x:Name="EmptyState" VerticalAlignment="Center" Margin="24">
                        <StackPanel>
                            <TextBlock Text="No game selected" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                            <TextBlock Text="Select a game from the list to view its details."
                                       Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                        <TextBox x:Name="GameNameBox" FontSize="17" FontWeight="SemiBold"
                                 Background="Transparent" BorderThickness="0,0,0,1" Padding="0,0,0,5"
                                 LostFocus="GameNameBox_LostFocus" KeyDown="GameNameBox_KeyDown" />
                        <TextBlock x:Name="InstallDateText" Grid.Row="1" Foreground="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,6,0,15" />

                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PlayCountText" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Launches" Style="{StaticResource FieldLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PlayTimeText" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Play time" Style="{StaticResource FieldLabel}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="FavoriteCheckBox" Grid.Row="3" Content="Favorite"
                                  Checked="FavoriteCheckBox_Changed" Unchecked="FavoriteCheckBox_Changed"
                                  Margin="0,0,0,15" />

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Launch arguments" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ArgumentsBox" LostFocus="ArgumentsBox_LostFocus" Margin="0,0,0,12" />
                            <TextBlock Text="Executable" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExecutableBox" IsReadOnly="True" Foreground="{StaticResource TextSecondary}"
                                     TextWrapping="NoWrap" Margin="0,0,0,7" />
                            <Button Click="ChooseExecutableButton_Click" Content="Change Executable..."
                                    HorizontalAlignment="Left" Padding="10,5" />
                        </StackPanel>

                        <Border Grid.Row="5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,10" Margin="0,12,0,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Compatibility" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Score" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="CompatibilityScoreText" Grid.Column="1" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="Runnable" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="CompatibilityRunnableText" Grid.Row="1" Grid.Column="1" />
                                    <TextBlock Grid.Row="2" Text="Compilable" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="CompatibilityCompilableText" Grid.Row="2" Grid.Column="1" />
                                    <TextBlock Grid.Row="3" Text="Version" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="CompatibilityVersionText" Grid.Row="3" Grid.Column="1" />
                                </Grid>
                                <TextBlock Text="Compatibility notes" Style="{StaticResource FieldLabel}"
                                           Margin="0,10,0,4" />
                                <TextBlock x:Name="CompatibilityNotesText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                            <StackPanel Grid.Row="6">
                                <Button Click="PlayButton_Click" Content="Play" Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,0,7" />
                                <Button Click="RevealButton_Click" Content="Open Install Folder" Margin="0,0,0,7" />
                                <Button Click="UninstallButton_Click" Content="Uninstall" Foreground="#A02020" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#F1F1F1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="7,0">
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="LibraryCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" />
            </Grid>
        </Border>

        <Grid x:Name="InstallOverlay" Grid.RowSpan="4" Background="#70000000"
              Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" BorderBrush="#777777" BorderThickness="1" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Installing game" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="InstallNameText" Grid.Row="1" Margin="0,5,0,18"
                               Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="2" Margin="0,0,0,7">
                        <TextBlock x:Name="InstallStageText" />
                        <TextBlock x:Name="InstallPercentText" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar x:Name="InstallProgressBar" Grid.Row="3"
                                 Style="{StaticResource InstallProgressStyle}" Minimum="0" Maximum="100" />
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <TextBlock x:Name="InstallDetailText" Width="310" HorizontalAlignment="Left"
                                   FontSize="10" Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="CancelInstallButton" HorizontalAlignment="Right" Padding="11,5"
                                Click="CancelInstallButton_Click" Content="Cancel" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
